<%- include('partials/header', { title }) %>

<section class="auth-shell">
  <form class="auth-card panel" action="/forgot-password" method="POST">
    <h1>Forgot Password</h1>
    <p>Enter your registered email to generate a reset code.</p>

    <label for="email">Registered Email</label>
    <input id="email" name="email" type="email" required>

    <button type="submit" class="btn btn-primary">Generate Reset Code</button>
    <p class="muted"><a href="/login">Back to login</a></p>
  </form>
</section>

<%- include('partials/footer') %>
