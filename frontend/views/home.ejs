<%- include('partials/header', { title }) %>

<section class="page-hero">
  <div>
    <p class="eyebrow">Daily Student Utility</p>
    <h1>Fast, clean, and reliable lost-and-found operations.</h1>
    <p>Designed for real campus usage with quick reporting, easy discovery, and clear status tracking.</p>
    <% if (!currentUser) { %>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/signup">Create Account</a>
        <a class="btn btn-outline" href="/login">Login</a>
      </div>
      <p class="muted">Want to know the full purpose? <a href="/why-this-site">Read Why This Site</a>.</p>
    <% } else { %>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/items/new">Post New Listing</a>
        <a class="btn btn-outline" href="/dashboard">Open Dashboard</a>
      </div>
    <% } %>
  </div>
  <div class="stat-cluster">
    <article class="stat-card">
      <p>Users</p>
      <strong><%= stats.total_users || 0 %></strong>
    </article>
    <article class="stat-card">
      <p>Listings</p>
      <strong><%= stats.total_listings || 0 %></strong>
    </article>
    <article class="stat-card">
      <p>Open Cases</p>
      <strong><%= stats.open_listings || 0 %></strong>
    </article>
  </div>
</section>

<section class="panel utility-grid">
  <article>
    <h3>Quick Reporting</h3>
    <p>Post complete item details in under one minute with category, location, and contact information.</p>
  </article>
  <article>
    <h3>Smart Discovery</h3>
    <p>Use keyword, category, and status filters to find relevant listings quickly.</p>
  </article>
  <article>
    <h3>Secure Workflow</h3>
    <p>Authenticated actions and admin monitoring make the platform safe for daily use.</p>
  </article>
</section>

<section class="panel">
  <h2 class="section-title">Search and Filter Listings</h2>
  <form class="search-grid" method="GET" action="/">
    <div>
      <label for="q">Keyword</label>
      <input id="q" name="q" type="text" value="<%= filters.q %>" placeholder="Item name, description, location">
    </div>
    <div>
      <label for="category">Category</label>
      <select id="category" name="category">
        <option value="">All Categories</option>
        <% categories.forEach((entry) => { %>
          <option value="<%= entry.category %>" <%= filters.category === entry.category ? 'selected' : '' %>><%= entry.category %></option>
        <% }) %>
      </select>
    </div>
    <div>
      <label for="status">Status</label>
      <select id="status" name="status">
        <option value="OPEN" <%= filters.status === 'OPEN' ? 'selected' : '' %>>Open</option>
        <option value="CLAIMED" <%= filters.status === 'CLAIMED' ? 'selected' : '' %>>Claimed</option>
        <option value="RESOLVED" <%= filters.status === 'RESOLVED' ? 'selected' : '' %>>Resolved</option>
        <option value="ALL" <%= filters.status === 'ALL' ? 'selected' : '' %>>All</option>
      </select>
    </div>
    <div class="search-actions">
      <button type="submit" class="btn btn-primary">Apply</button>
      <a class="btn btn-outline" href="/">Reset</a>
    </div>
  </form>
</section>

<section class="panel">
  <h2 class="section-title">Listings Feed</h2>
  <% if (!items.length) { %>
    <p class="muted">No listings match your filters yet. Try resetting filters or posting a new item.</p>
  <% } %>

  <div class="card-grid">
    <% items.forEach((item) => { %>
      <article class="card reveal">
        <div class="tag-row">
          <span class="tag"><%= item.category %></span>
          <span class="status <%= item.status.toLowerCase() %>"><%= item.status %></span>
        </div>
        <h3><%= item.title %></h3>
        <p><%= item.description.substring(0, 120) %><%= item.description.length > 120 ? '...' : '' %></p>
        <p class="meta">Posted by <%= item.owner_name %></p>
        <a class="read-more" href="/items/<%= item.id %>">View details</a>
      </article>
    <% }) %>
  </div>
</section>

<section class="panel process-grid">
  <h2 class="section-title">Student Workflow</h2>
  <article class="step-card">
    <span>01</span>
    <h3>Create Listing</h3>
    <p>Report lost or found item details with accurate category and location.</p>
  </article>
  <article class="step-card">
    <span>02</span>
    <h3>Find Match</h3>
    <p>Use search and status filters to identify relevant items quickly.</p>
  </article>
  <article class="step-card">
    <span>03</span>
    <h3>Close Case</h3>
    <p>Claim, verify owner details, and mark as resolved to keep records clean.</p>
  </article>
</section>

<%- include('partials/footer') %>
