<%- include('partials/header', { title }) %>

<article class="item-detail panel reveal">
  <div class="tag-row">
    <span class="tag"><%= item.category %></span>
    <span class="status <%= item.status.toLowerCase() %>"><%= item.status %></span>
  </div>

  <h1><%= item.title %></h1>
  <p class="lead"><%= item.description %></p>

  <dl class="detail-grid">
    <div>
      <dt>Posted by</dt>
      <dd><%= item.owner_name %></dd>
    </div>
    <div>
      <dt>Contact</dt>
      <dd><%= item.contact_info %></dd>
    </div>
    <div>
      <dt>Lost location</dt>
      <dd><%= item.location_lost || 'Not specified' %></dd>
    </div>
    <div>
      <dt>Found location</dt>
      <dd><%= item.location_found || 'Not specified' %></dd>
    </div>
    <div>
      <dt>Claimed by</dt>
      <dd><%= item.claimant_name || 'No one yet' %></dd>
    </div>
  </dl>

  <% if (currentUser && currentUser.id !== item.owner_id && item.status === 'OPEN') { %>
    <form action="/items/<%= item.id %>/claim" method="POST">
      <button class="btn btn-primary" type="submit">Claim This Item</button>
    </form>
  <% } %>
</article>

<%- include('partials/footer') %>
