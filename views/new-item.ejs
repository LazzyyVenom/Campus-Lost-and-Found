<%- include('partials/header', { title }) %>

<section class="form-shell">
  <form class="item-form panel" action="/items" method="POST">
    <h1>Post a Lost/Found Item</h1>

    <label for="title">Title</label>
    <input id="title" name="title" type="text" placeholder="Blue Water Bottle" required>

    <label for="category">Category</label>
    <input id="category" name="category" type="text" placeholder="Accessories, Electronics, Documents..." required>

    <label for="description">Description</label>
    <textarea id="description" name="description" rows="5" placeholder="Add details to help identify the item" required></textarea>

    <div class="split">
      <div>
        <label for="locationLost">Where was it lost?</label>
        <input id="locationLost" name="locationLost" type="text" placeholder="Library 2nd floor">
      </div>
      <div>
        <label for="locationFound">Where was it found?</label>
        <input id="locationFound" name="locationFound" type="text" placeholder="Cafeteria table B-4">
      </div>
    </div>

    <label for="contactInfo">Contact Info</label>
    <input id="contactInfo" name="contactInfo" type="text" placeholder="Phone/email/room number" required>

    <button type="submit" class="btn btn-primary">Publish Listing</button>
  </form>
</section>

<%- include('partials/footer') %>
