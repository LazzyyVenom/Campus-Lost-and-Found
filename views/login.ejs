<%- include('partials/header', { title }) %>

<section class="auth-shell">
  <form class="auth-card panel" action="/login" method="POST">
    <h1>Welcome Back</h1>
    <p>Log in to manage your lost and found items.</p>

    <label for="email">Email</label>
    <input id="email" name="email" type="email" required>

    <label for="password">Password</label>
    <div class="password-field">
      <input id="password" name="password" type="password" required>
      <button type="button" class="password-toggle" data-toggle-password="password">Show</button>
    </div>

    <button type="submit" class="btn btn-primary">Login</button>
    <p class="muted"><a href="/forgot-password">Forgot password?</a></p>
    <p class="muted">No account yet? <a href="/signup">Create one</a></p>
  </form>
</section>

<%- include('partials/footer') %>
