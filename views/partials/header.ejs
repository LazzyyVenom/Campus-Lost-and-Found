<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Lost & Found</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;700;800&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <div class="aurora"></div>
  <header class="site-header">
    <a class="brand" href="/">
      <span class="brand-mark">LF</span>
      <span>Campus Lost & Found</span>
    </a>
    <nav class="nav-links">
      <a href="/">Home</a>
      <a href="/why-this-site">Why This Site</a>
      <% if (currentUser) { %>
        <a href="/dashboard">Dashboard</a>
        <a href="/items/new">Post Item</a>
        <% if (currentUser.isAdmin) { %>
          <a href="/admin/login-logs">Login Logs</a>
        <% } %>
        <form action="/logout" method="POST" class="inline-form">
          <button class="btn btn-muted" type="submit">Logout</button>
        </form>
      <% } else { %>
        <a href="/login">Login</a>
        <a class="btn btn-primary" href="/signup">Sign Up</a>
      <% } %>
    </nav>
  </header>

  <main class="container">
    <% if (flash) { %>
      <div class="flash <%= flash.type %>"><%= flash.message %></div>
    <% } %>
