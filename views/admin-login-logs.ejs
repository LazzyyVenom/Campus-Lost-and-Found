<%- include('partials/header', { title }) %>

<section class="page-hero compact">
  <div>
    <p class="eyebrow">Admin Panel</p>
    <h1>Login Audit Trail</h1>
    <p class="muted">This table tracks successful and failed login attempts with time and network details.</p>
  </div>
  <div class="stat-cluster">
    <article class="stat-card">
      <p>Total</p>
      <strong><%= stats.total_attempts || 0 %></strong>
    </article>
    <article class="stat-card">
      <p>Success</p>
      <strong><%= stats.total_success || 0 %></strong>
    </article>
    <article class="stat-card">
      <p>Failure</p>
      <strong><%= stats.total_failure || 0 %></strong>
    </article>
  </div>
</section>

<section class="panel table-wrap">
  <% if (!logs.length) { %>
    <p class="muted">No login activity recorded yet.</p>
  <% } else { %>
    <table class="logs-table">
      <thead>
        <tr>
          <th>Time</th>
          <th>User</th>
          <th>Email Attempted</th>
          <th>Status</th>
          <th>IP Address</th>
          <th>User Agent</th>
        </tr>
      </thead>
      <tbody>
        <% logs.forEach((log) => { %>
          <tr>
            <td><%= log.attempted_at %></td>
            <td><%= log.user_name || '-' %></td>
            <td><%= log.email_attempted %></td>
            <td>
              <span class="status <%= log.login_status.toLowerCase() === 'success' ? 'open' : 'resolved' %>">
                <%= log.login_status %>
              </span>
            </td>
            <td><%= log.ip_address || '-' %></td>
            <td><%= log.user_agent || '-' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</section>

<%- include('partials/footer') %>
